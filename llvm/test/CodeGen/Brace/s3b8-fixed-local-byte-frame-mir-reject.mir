# REQUIRES: brace-registered-target
#
# Every serialized S3b.8 seam is untrusted.  This test constructs the sole
# admitted FI1 ordinal-equivalence carrier, replays it through all five seams,
# and mutates lifetime/local/MFI/MMO/final/publication/resource identities one
# at a time.  A reject must be stable, nonzero, and publish no nonempty object.
#
# DEFINE: %{brace-s3b8-llc} = llc -mtriple=brace64-unknown-none-elf \
# DEFINE:   -target-abi=brace-system-s2-direct-call-byte-frame-fixed-local-r0 \
# DEFINE:   -O1 -verify-machineinstrs -filetype=obj
# DEFINE: %{brace-s3b7c-llc} = llc -mtriple=brace64-unknown-none-elf \
# DEFINE:   -target-abi=brace-system-s2-direct-call-byte-frame-r0 \
# DEFINE:   -O1 -verify-machineinstrs -filetype=obj
#
# RUN: rm -rf %t.parts %t.ir
# RUN: split-file %s %t.parts
# RUN: split-file %S/s3b8-fixed-local-byte-frame.ll %t.ir
# RUN: llvm-as %t.ir/fl1.ll -o %t.fl1.bc
# RUN: %{brace-s3b8-llc} %t.fl1.bc -o %t.canonical.o
# RUN: %{brace-s3b8-llc} -stop-after=finalize-isel %t.fl1.bc -o %t.isel.mir
# RUN: %{brace-s3b8-llc} -stop-after=virtregrewriter %t.fl1.bc -o %t.ra.mir
# RUN: %{brace-s3b8-llc} -stop-after=stack-slot-coloring %t.fl1.bc -o %t.color.mir
# RUN: %{brace-s3b8-llc} \
# RUN:   -stop-after=brace-finalize-fixed-local-byte-frame %t.fl1.bc \
# RUN:   -o %t.frame.mir
# RUN: %{brace-s3b8-llc} -stop-after=brace-finalize-branches %t.fl1.bc \
# RUN:   -o %t.final.mir
#
# Construct one exact metadata-only spill bookkeeping FI0 before local FI1.
# It must survive the first three serialized seams and disappear before the
# fourth; every restart converges on the natural-FI0 canonical object.
# RUN: %python %t.parts/construct-fi1.py 1 %t.isel.mir %t.fi1.isel.mir
# RUN: FileCheck %s --check-prefix=FI1-PRE < %t.fi1.isel.mir
# RUN: %{brace-s3b8-llc} -start-after=finalize-isel \
# RUN:   -stop-after=virtregrewriter %t.fi1.isel.mir -o %t.fi1.ra.mir
# RUN: FileCheck %s --check-prefix=FI1-PRE < %t.fi1.ra.mir
# RUN: %{brace-s3b8-llc} -start-after=virtregrewriter \
# RUN:   -stop-after=stack-slot-coloring %t.fi1.ra.mir -o %t.fi1.color.mir
# RUN: FileCheck %s --check-prefix=FI1-PRE < %t.fi1.color.mir
# RUN: %{brace-s3b8-llc} -start-after=stack-slot-coloring \
# RUN:   -stop-after=brace-finalize-fixed-local-byte-frame %t.fi1.color.mir \
# RUN:   -o %t.fi1.frame.mir
# RUN: FileCheck %s --check-prefix=FI1-POST < %t.fi1.frame.mir
# RUN: %{brace-s3b8-llc} \
# RUN:   -start-after=brace-finalize-fixed-local-byte-frame \
# RUN:   -stop-after=brace-finalize-branches %t.fi1.frame.mir \
# RUN:   -o %t.fi1.final.mir
# RUN: FileCheck %s --check-prefix=FI1-POST < %t.fi1.final.mir
# RUN: %{brace-s3b8-llc} -start-after=finalize-isel %t.fi1.isel.mir \
# RUN:   -o %t.fi1.from-isel.o
# RUN: %{brace-s3b8-llc} -start-after=virtregrewriter %t.fi1.ra.mir \
# RUN:   -o %t.fi1.from-ra.o
# RUN: %{brace-s3b8-llc} -start-after=stack-slot-coloring %t.fi1.color.mir \
# RUN:   -o %t.fi1.from-color.o
# RUN: %{brace-s3b8-llc} \
# RUN:   -start-after=brace-finalize-fixed-local-byte-frame %t.fi1.frame.mir \
# RUN:   -o %t.fi1.from-frame.o
# RUN: %{brace-s3b8-llc} -start-after=brace-finalize-branches \
# RUN:   %t.fi1.final.mir -o %t.fi1.from-final.o
# RUN: cmp %t.canonical.o %t.fi1.from-isel.o
# RUN: cmp %t.canonical.o %t.fi1.from-ra.o
# RUN: cmp %t.canonical.o %t.fi1.from-color.o
# RUN: cmp %t.canonical.o %t.fi1.from-frame.o
# RUN: cmp %t.canonical.o %t.fi1.from-final.o
#
# FI1 is the sole ordinal exception: two leading records, a wrong bookkeeping
# field, a reference to FI0, or a following record are all rejected.
# RUN: %python %t.parts/construct-fi1.py 2 %t.ra.mir %t.fi2.ra.mir
# RUN: not --crash %{brace-s3b8-llc} -start-after=virtregrewriter \
# RUN:   %t.fi2.ra.mir -o %t.fi2.o 2>&1 | FileCheck %s --check-prefix=BOOKKEEPING
# RUN: test ! -s %t.fi2.o
# RUN: %python %t.parts/mutate.py bookkeeping-size %t.fi1.ra.mir \
# RUN:   %t.fi1.bad-size.mir
# RUN: not --crash %{brace-s3b8-llc} -start-after=virtregrewriter \
# RUN:   %t.fi1.bad-size.mir -o %t.fi1.bad-size.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BOOKKEEPING
# RUN: test ! -s %t.fi1.bad-size.o
# RUN: %python %t.parts/mutate.py bookkeeping-ref %t.fi1.ra.mir \
# RUN:   %t.fi1.ref.mir
# RUN: not --crash %{brace-s3b8-llc} -start-after=virtregrewriter \
# RUN:   %t.fi1.ref.mir -o %t.fi1.ref.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BOOKKEEPING-REF
# RUN: test ! -s %t.fi1.ref.o
# RUN: %python %t.parts/mutate.py following-record %t.ra.mir \
# RUN:   %t.following.mir
# RUN: not --crash %{brace-s3b8-llc} -start-after=virtregrewriter \
# RUN:   %t.following.mir -o %t.following.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BOOKKEEPING
# RUN: test ! -s %t.following.o
#
# Pre-final lifetime/local/MFI/MMO carriers remain exact.  These cases cover
# missing/extra/reordered markers, ordinary-vs-spill provenance, private MFI
# offset drift, local MMO drift, a FixedStack MMO, and an Alloca-backed MMO
# laundered onto an otherwise nonlocal instruction.
# RUN: %python %t.parts/mutate.py local-spill %t.ra.mir %t.local-spill.mir
