#
# Resource preflight is distinct from final exact-shape validation.  Base 11
# plus 115 operations reaches pre-final 126 and therefore the exact root-shape
# error; base plus 116 reaches 127 and fails the reserved Enter/Leave check
# first.  Neither negative publishes bytes.
# RUN: %python %t.parts/resource.py 115 %t.ra.mir %t.resource-126.mir
# RUN: not --crash %{brace-s3b8-llc} -start-after=virtregrewriter \
# RUN:   %t.resource-126.mir -o %t.resource-126.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=RESOURCE-SHAPE
# RUN: test ! -s %t.resource-126.o
