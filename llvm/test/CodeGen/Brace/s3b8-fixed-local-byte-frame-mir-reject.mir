#
# Serialized post-final restarts intentionally begin with stack: [] and an
# empty target MFI.  They regenerate the private tag only after revalidating
# final MIR.  Restored MFI/FI/MMO/lifetime state is rejected.
# RUN: %{brace-s3b8-llc} \
# RUN:   -start-after=brace-finalize-fixed-local-byte-frame %t.frame.mir \
# RUN:   -o %t.empty-mfi-restart.o
# RUN: cmp %t.canonical.o %t.empty-mfi-restart.o
# RUN: %python %t.parts/mutate.py live-stack %t.frame.mir %t.live-stack.mir
# RUN: not --crash %{brace-s3b8-llc} \
# RUN:   -start-after=brace-finalize-fixed-local-byte-frame %t.live-stack.mir \
