# RUN: %python -c "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())" %t.old-bf1.o | FileCheck %s --check-prefix=OLD-BF1-SHA
#
# FI1-PRE-LABEL: name: brace_system_entry
# FI1-PRE: stack:
# FI1-PRE-NEXT: - { id: 0,{{( name: '',)? }}type: spill-slot, offset: 0, size: 4, alignment: 4
# FI1-PRE: - { id: 1, name: local, type: default, offset: 0, size: 4, alignment: 4,
# FI1-PRE: LIFETIME_START %stack.1.local
# FI1-PRE: LOCAL_STORE32 {{.*}}, %stack.1.local
# FI1-PRE: LOCAL_LOAD32 %stack.1.local
# FI1-PRE: LIFETIME_END %stack.1.local
# FI1-POST-LABEL: name: brace_system_entry
# FI1-POST: stack: []
# FI1-POST: machineFunctionInfo: {}
# FI1-POST: FRAME_ENTER 16
# FI1-POST: FRAME_STORE32 8, $r4
# FI1-POST-NEXT: CALL_I32
# FI1-POST-NEXT: $r5 = FRAME_LOAD32 8
# FI1-POST-NOT: %stack.
#
# BOOKKEEPING: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: frame object is neither the natural local nor exact FI1 restart bookkeeping
# BOOKKEEPING-REF: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: local carriers disagree on their frame index
# LOCAL-MFI: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: carrier does not refer to the exact live ordinary i32 local
# LIFETIME-COUNT: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: FL1 requires one start/store/call/load/end carrier sequence
# LOCAL-ADJACENCY: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: FL1 local carrier adjacency is not exact
# LOCAL-MMO: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: local carrier lost its exact volatile i32 IR-backed MMO
# NONLOCAL-LOCAL-MMO: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: nonlocal instruction carries the fixed-local MMO
# SPILL-LOCAL: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: allocator spill is forbidden by the fixed-local profile
# PRE-FRAME: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: semantic frame operation appeared before finalization
# POST-LIVE-MFI: LLVM ERROR: brace64 S3b.8 post-fixed-local-byte-frame verifier: live, allocated, aliased, or nondefault frame object survived finalization
# POST-PRIVATE: LLVM ERROR: brace64 S3b.8 post-fixed-local-byte-frame verifier: private local/spill/lifetime carrier survived publication
# OFFSET8: LLVM ERROR: brace64 S3b.8 post-fixed-local-byte-frame verifier: FrameStore32 is not exact fixed-local offset=8
# FRAME-SIZE: LLVM ERROR: brace64 S3b.8 post-fixed-local-byte-frame verifier: FrameEnter is not exact frame_size=16
# FINAL-EXTRA: LLVM ERROR: brace64 S3b.8 post-fixed-local-byte-frame verifier: FL1 root operation count is not exact eleven
# FINAL-SHAPE: LLVM ERROR: brace64 S3b.8 post-fixed-local-byte-frame verifier: FL1 requires one Enter, Store32, Load32, and Leave
# FINAL-ORDER: LLVM ERROR: brace64 S3b.8 post-fixed-local-byte-frame verifier: FL1 requires FrameStore32(8), Call, FrameLoad32(8) adjacency
# RESOURCE-SHAPE: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: FL0/FL1 pre-finalization root operation count is not exact
# RESOURCE-RESERVE: LLVM ERROR: brace64 S3b.8 fixed-local finalizer: FL1 cannot reserve Enter/Leave within the operation limit
# UNREGISTERED-RESTART: LLVM ERROR: brace64 S3b.8 fixed-local selector: -start-after=brace-verify-final-fixed-local-publication is not one of the five registered restart seams
# DUPLICATE-START-AFTER: LLVM ERROR: brace64 S3b.8 fixed-local selector: -start-after is specified more than once
# EMPTY-START-AFTER: LLVM ERROR: brace64 S3b.8 fixed-local selector: -start-after requires a nonempty pass name
# DUPLICATE-STOP-AFTER: LLVM ERROR: brace64 S3b.8 fixed-local selector: -stop-after is specified more than once
# EMPTY-STOP-AFTER: LLVM ERROR: brace64 S3b.8 fixed-local selector: -stop-after requires a nonempty pass name
# START-BEFORE: LLVM ERROR: brace64 S3b.8 fixed-local selector: -start-before=virtregrewriter is not an admitted restart boundary
# STOP-BEFORE: LLVM ERROR: brace64 S3b.8 fixed-local selector: -stop-before=virtregrewriter is not an admitted stop boundary
# UNREGISTERED-STOP: LLVM ERROR: brace64 S3b.8 fixed-local selector: -stop-after=machine-opt-remark-emitter,2 is neither one of the five registered restart seams nor the audit-only final-publication stop
# RAW-START-AFTER: error: brace64 S3b.8 fixed-local selector: explicit -start-after requires MIR input
# MIR-WITHOUT-START: error: brace64 S3b.8 fixed-local selector: MIR input requires one explicit registered -start-after
# PAIR-REJECT: LLVM ERROR: brace64 S3b.8 fixed-local selector: start/stop pass-limit pair is not one of the four registered forward propagation pairs
# PIPELINE-OPTION: error: brace64 S3b.8 fixed-local selector: explicit -run-pass, -passes, or -enable-new-pm is outside the registered pipeline
# PIPELINE: Pass Arguments:
# PIPELINE-SAME: -stack-slot-coloring
# PIPELINE-SAME: -machineverifier -brace-finalize-fixed-local-byte-frame -machineverifier -brace-verify-post-fixed-local-byte-frame
# PIPELINE-SAME: -stack-frame-layout -machineverifier -brace-finalize-branches -machineverifier -brace-verify-final-fixed-local-publication
# OLD-BF1-SHA: cb09ac307141381c709d1504bab2f74b274a0b50e42b20cad593f9bf2846fb55

#--- construct-fi1.py
from pathlib import Path
import sys

assert len(sys.argv) == 4
dead_count = int(sys.argv[1])
assert dead_count in (1, 2)
source = Path(sys.argv[2]).read_text()
root_marker = "name:            brace_system_entry\n"
leaf_marker = "name:            brace_system_call_leaf\n"
assert source.count(root_marker) == 1
assert source.count(leaf_marker) == 1
root_start = source.index(root_marker)
root_end = source.index(leaf_marker, root_start)
root = source[root_start:root_end]
stack_start = root.index("stack:\n")
stack_end = root.index("entry_values:", stack_start)
stack = root[stack_start:stack_end]
assert stack.count("  - { id: 0, name: local, type: default,") == 1
assert stack.count("  - { id:") == 1
local = stack.replace("id: 0", f"id: {dead_count}", 1)
bookkeeping = "".join(
    f"  - {{ id: {i}, type: spill-slot, offset: 0, size: 4, alignment: 4 }}\n"
    for i in range(dead_count))
stack = "stack:\n" + bookkeeping + local[len("stack:\n"):]
root = root[:stack_start] + stack + root[stack_end:]
body_start = root.index("body:")
assert root[:body_start].count("%stack.0") == 0
assert root[body_start:].count("%stack.0.local") == 4
root = root[:body_start] + root[body_start:].replace(
    "%stack.0.local", f"%stack.{dead_count}.local")
result = source[:root_start] + root + source[root_end:]
Path(sys.argv[3]).write_text(result)

#--- mutate.py
from pathlib import Path
import sys

assert len(sys.argv) == 4
mode, source_path, output_path = sys.argv[1:]
text = Path(source_path).read_text()
root_marker = "name:            brace_system_entry\n"
leaf_marker = "name:            brace_system_call_leaf\n"
assert text.count(root_marker) == 1
assert text.count(leaf_marker) == 1
root_start = text.index(root_marker)
root_end = text.index(leaf_marker, root_start)
root = text[root_start:root_end]

def once(old, new):
    global root
    assert root.count(old) == 1, (mode, old, root.count(old))
    root = root.replace(old, new, 1)

def add_stack():
    once("stack:           []\n",
         "stack:\n"
         "  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4 }\n")

if mode == "bookkeeping-size":
    once("type: spill-slot, offset: 0, size: 4, alignment: 4",
         "type: spill-slot, offset: 0, size: 8, alignment: 4")
elif mode == "bookkeeping-ref":
    once("    LIFETIME_START %stack.1.local\n",
         "    LIFETIME_START %stack.0\n")
elif mode == "following-record":
    anchor = ("      debug-info-variable: '', debug-info-expression: '', "
              "debug-info-location: '' }\n")
    once(anchor, anchor +
         "  - { id: 1, type: spill-slot, offset: 0, size: 4, alignment: 4 }\n")
elif mode == "local-spill":
    once("name: local, type: default", "name: local, type: spill-slot")
elif mode == "local-size":
    once("name: local, type: default, offset: 0, size: 4, alignment: 4",
         "name: local, type: default, offset: 0, size: 8, alignment: 4")
elif mode == "local-offset":
    once("name: local, type: default, offset: 0, size: 4, alignment: 4",
         "name: local, type: default, offset: 4, size: 4, alignment: 4")
elif mode == "missing-start":
    once("    LIFETIME_START %stack.0.local\n", "")
elif mode == "duplicate-end":
    line = "    LIFETIME_END %stack.0.local\n"
    once(line, line + line)
elif mode == "reordered-start":
    start = "    LIFETIME_START %stack.0.local\n"
    store = ("    LOCAL_STORE32 $r4, %stack.0.local :: "
             "(volatile store (s32) into %ir.local)\n")
    once(start, "")
    once(store, store + start)
elif mode == "local-mmo-nonvolatile":
    once("(volatile store (s32) into %ir.local)",
         "(store (s32) into %ir.local)")
elif mode == "local-mmo-fixed":
    once("(volatile store (s32) into %ir.local)",
         "(volatile store (s32) into %stack.0)")
elif mode == "nonlocal-local-mmo":
    line = next(line for line in root.splitlines(keepends=True)
                if line.startswith("    $r4 = LOAD32 killed $r0 :: "))
    once(line, line.rstrip("\n") + ", (load (s32) from %ir.local)\n")
elif mode == "spill-local":
    once("    LOCAL_STORE32 $r4, %stack.0.local ::",
         "    SPILL_STORE32 $r4, %stack.0.local ::")
elif mode == "pre-frame":
    line = next(line for line in root.splitlines(keepends=True)
                if line.startswith("    LOCAL_STORE32 $r4,"))
    once(line, "    FRAME_STORE32 8, $r4\n")
elif mode == "live-stack":
    add_stack()
elif mode == "post-fi":
    add_stack()
    once("    FRAME_STORE32 8, $r4\n",
         "    FRAME_STORE32 %stack.0, $r4\n")
elif mode == "post-mmo":
    add_stack()
    once("    FRAME_STORE32 8, $r4\n",
         "    FRAME_STORE32 8, $r4 :: (store (s32) into %stack.0)\n")
elif mode == "post-lifetime":
    add_stack()
    once("    FRAME_ENTER 16\n",
         "    FRAME_ENTER 16\n    LIFETIME_START %stack.0\n")
elif mode == "offset4":
    once("    FRAME_STORE32 8, $r4\n", "    FRAME_STORE32 4, $r4\n")
    once("    $r5 = FRAME_LOAD32 8\n", "    $r5 = FRAME_LOAD32 4\n")
elif mode == "offset16":
    once("    FRAME_STORE32 8, $r4\n", "    FRAME_STORE32 16, $r4\n")
    once("    $r5 = FRAME_LOAD32 8\n", "    $r5 = FRAME_LOAD32 16\n")
elif mode == "frame-size":
    once("    FRAME_ENTER 16\n", "    FRAME_ENTER 32\n")
elif mode == "final-extra":
    once("    FRAME_ENTER 16\n",
         "    FRAME_ENTER 16\n    $r5 = CONST32 0\n")
elif mode == "no-leave":
    once("    FRAME_LEAVE\n", "")
elif mode == "store-after-call":
    store = "    FRAME_STORE32 8, $r4\n"
    call = ("    CALL_I32 @brace_system_call_leaf, csr_noregs, "
            "implicit-def $r4, implicit $r4\n")
    once(store, "")
    once(call, call + store)
else:
    raise AssertionError(mode)

Path(output_path).write_text(text[:root_start] + root + text[root_end:])

#--- resource.py
from pathlib import Path
import sys

assert len(sys.argv) == 4
count = int(sys.argv[1])
assert count in (115, 116)
text = Path(sys.argv[2]).read_text()
root_marker = "name:            brace_system_entry\n"
leaf_marker = "name:            brace_system_call_leaf\n"
root_start = text.index(root_marker)
root_end = text.index(leaf_marker, root_start)
root = text[root_start:root_end]
anchor = "  bb.0.entry:\n"
assert root.count(anchor) == 1
extra = "".join("    $r5 = CONST32 0\n" for _ in range(count))
root = root.replace(anchor, anchor + extra, 1)
Path(sys.argv[3]).write_text(text[:root_start] + root + text[root_end:])
