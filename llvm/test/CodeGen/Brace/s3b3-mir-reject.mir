# RUN: test ! -s %t.dir/wrong-as-mmo.o
# RUN: sed 's/align 1048576, addrspace 200/align 2, addrspace 200/' \
# RUN:   %t.dir/direct.mir > %t.dir/misaligned-mmo.mir
# RUN: not --crash %{brace-s3-llc} -start-after=virtregrewriter \
# RUN:   %t.dir/misaligned-mmo.mir -o %t.dir/misaligned-mmo.o
# RUN: test ! -s %t.dir/misaligned-mmo.o
# RUN: sed 's/PADDR_IMM 1048576/PADDR_IMM 1/' \
# RUN:   %t.dir/direct.mir > %t.dir/address-mismatch.mir
# RUN: not --crash %{brace-s3-llc} -start-after=virtregrewriter \
# RUN:   %t.dir/address-mismatch.mir -o %t.dir/address-mismatch.o
