#
# A branch target with no emitting operation and an out-of-range MBB name are
# separate validator/parser boundaries.
# RUN: sed 's/^    RET$/    /' %t.dir/diamond.mir > %t.dir/empty-target.mir
# RUN: not --crash %{brace-s3-llc} -start-after=virtregrewriter \
# RUN:   %t.dir/empty-target.mir -o %t.dir/empty-target.o
