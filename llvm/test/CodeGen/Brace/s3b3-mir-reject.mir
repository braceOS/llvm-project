# RUN:   %t.dir/bad-target.mir -o %t.dir/bad-target.o
# RUN: test ! -s %t.dir/bad-target.o
#
# The post-RA trust boundary must revalidate the complete memory effect, not
# merely trust the MachineInstr opcode selected earlier.
# RUN: sed 's/(volatile store/(store/' \
# RUN:   %t.dir/direct.mir > %t.dir/nonvolatile-mmo.mir
# RUN: not --crash %{brace-s3-llc} -start-after=virtregrewriter \
