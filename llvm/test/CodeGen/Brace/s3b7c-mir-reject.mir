# REQUIRES: brace-registered-target
#
# Every restart seam is untrusted.  Generate canonical MIR from the normalized
# producer, mutate one target-owned invariant at a time, and require rejection
# before any object bytes are published.
#
# DEFINE: %{brace-s3b7c-llc} = llc -mtriple=brace64-unknown-none-elf \
# DEFINE:   -target-abi=brace-system-s2-direct-call-byte-frame-r0 -O1 \
# DEFINE:   -verify-machineinstrs -filetype=obj
# DEFINE: %{brace-s3b6-llc} = llc -mtriple=brace64-unknown-none-elf \
# DEFINE:   -target-abi=brace-system-s2-direct-call-home-r0 -O1 \
# DEFINE:   -verify-machineinstrs -filetype=obj
# RUN: split-file %s %t.parts
#
# RUN: %{brace-s3b7c-llc} -stop-after=virtregrewriter \
# RUN:   %S/s3b7c-direct-call-byte-frame.ll -o %t.ra.mir
# RUN: %python %t.parts/renumber.py 1 %t.ra.mir %t.fi1.mir
# RUN: FileCheck %s --check-prefix=FI1-INPUT --input-file=%t.fi1.mir
# RUN: %{brace-s3b7c-llc} -start-after=virtregrewriter \
# RUN:   -stop-after=brace-finalize-byte-frame %t.ra.mir -o %t.fi0.frame.mir
# RUN: %{brace-s3b7c-llc} -start-after=virtregrewriter \
# RUN:   -stop-after=brace-finalize-byte-frame %t.fi1.mir -o %t.fi1.frame.mir
# RUN: FileCheck %s --check-prefix=FI-FINAL --input-file=%t.fi0.frame.mir
# RUN: FileCheck %s --check-prefix=FI-FINAL --input-file=%t.fi1.frame.mir
# RUN: %{brace-s3b7c-llc} -start-after=virtregrewriter \
# RUN:   %t.ra.mir -o %t.fi0.o
# RUN: %{brace-s3b7c-llc} -start-after=virtregrewriter \
# RUN:   %t.fi1.mir -o %t.fi1.o
# RUN: cmp %t.fi0.o %t.fi1.o
#
# Retained, fully revalidated IR is the independent BF0/BF1 intent authority
# at pre- and post-finalizer restart seams.  Removing the allocator's sole
# spill or all four semantic FRAME operations cannot silently downgrade the
# canonical BF1 source to BF0, even when the remaining physical MIR is a
# self-consistent no-frame program.
# RUN: %python %t.parts/remove-frame.py pre %t.ra.mir %t.no-spill.mir
# RUN: not --crash %{brace-s3b7c-llc} -start-after=virtregrewriter \
# RUN:   %t.no-spill.mir -o %t.no-spill.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=NO-SPILL
# RUN: test ! -s %t.no-spill.o
#
# Even with the CLI's automatic verifier disabled, the two explicitly named
# target-owned wrappers remain on both sides of byte-frame finalization and
# final branch publication.
# RUN: %{brace-s3b7c-llc} -verify-machineinstrs=false \
# RUN:   -start-after=virtregrewriter -debug-pass=Structure %t.ra.mir \
# RUN:   -o %t.no-auto-verifier.o 2> %t.pipeline.log
# RUN: FileCheck %s --check-prefix=PIPELINE --input-file=%t.pipeline.log
# RUN: grep -F 'Verify generated machine code' %t.pipeline.log | count 4
# RUN: cmp %t.fi0.o %t.no-auto-verifier.o
#
# The only restart-only normalization is one exact leading inert i32 spill
# record.  A second record or any field drift is rejected before mutation.
# RUN: %python %t.parts/renumber.py 2 %t.ra.mir %t.fi2.mir
# RUN: not --crash %{brace-s3b7c-llc} -start-after=virtregrewriter \
# RUN:   %t.fi2.mir -o %t.fi2.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BOOKKEEPING-MULTIPLE
# RUN: test ! -s %t.fi2.o
