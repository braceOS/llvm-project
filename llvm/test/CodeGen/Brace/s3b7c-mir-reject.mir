#
# Preflight reserves both inserted operation/tick words before mutation:
# 126+2 is exact, while 127+2 is rejected before FrameIndex removal.
# RUN: awk 'BEGIN { root=0; added=0 } \
# RUN:   /^name:            brace_system_entry$/ { root=1 } \
# RUN:   /^name:            brace_system_call_leaf$/ { root=0 } \
