# RUN:   %t.fi1.mir > %t.fi1-bad-size.mir
# RUN: not --crash %{brace-s3b7c-llc} -start-after=virtregrewriter \
# RUN:   %t.fi1-bad-size.mir -o %t.fi1-bad-size.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BOOKKEEPING-SHAPE
# RUN: test ! -s %t.fi1-bad-size.o
