# RUN:   -o %t.no-frame.o 2>&1 | FileCheck %s --check-prefix=NO-FRAME
# RUN: test ! -s %t.no-frame.o
# RUN: %python %t.parts/remove-frame.py post-mmo %t.frame.mir \
# RUN:   %t.no-frame-mmo.mir
# RUN: not --crash %{brace-s3b7c-llc} \
# RUN:   -start-after=brace-finalize-byte-frame %t.no-frame-mmo.mir \
# RUN:   -o %t.no-frame-mmo.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=NO-FRAME-MMO-FIRST
