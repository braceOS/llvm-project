#
# FIXED-MMO: LLVM ERROR: brace64 S3b.7c byte-frame finalizer: non-spill instruction carries a fixed-stack MMO
# PRE-HOME: LLVM ERROR: brace64 S3b.7c byte-frame finalizer: semantic-home operation appeared in the byte-frame ABI
# PRE-FRAME: LLVM ERROR: brace64 S3b.7c byte-frame finalizer: semantic byte-frame operation appeared before finalization
# SIZE-REJECT: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: FrameEnter operand is not exact frame_size=16
# OFFSET-REJECT: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: FrameStore32 operands are not exact offset=4/i32
# POST-HOME: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: semantic-home operation
# ORDER-REJECT: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: BF1 requires FrameStore32(4), Call, FrameLoad32(4) adjacency
# JOINT-REJECT: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: Call result and FrameLoad32 do not jointly reach one physical store
# LEAVE-REJECT: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: BF1 requires one Enter, Store32, Load32, and Leave
# ENTRY-BACKEDGE: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: function entry block has a predecessor or backedge
# OLD-BACKEDGE-SHA: 0e0843cb8ae46fc382ce1ce2a297dfd29f52b7e622167072118eb611d195eec8
# EXACT-128: Name: .brace.text
# EXACT-128: Size: 532
# ONE-MORE: LLVM ERROR: brace64 S3b.7c byte-frame finalizer: FrameEnter/FrameLeave would exceed the 128-operation publication limit
# FI1-INPUT-LABEL: name:            brace_system_entry
# FI1-INPUT: stack:
# FI1-INPUT-NEXT:  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4 }
# FI1-INPUT-NEXT:  - { id: 1, name: '', type: spill-slot
# FI1-INPUT: SPILL_STORE32 $r4, %stack.1 :: (store (s32) into %stack.1)
# FI1-INPUT: $r5 = SPILL_LOAD32 %stack.1 :: (load (s32) from %stack.1)
# FI-FINAL-LABEL: name:            brace_system_entry
# FI-FINAL: stack:           []
# FI-FINAL: FRAME_ENTER 16
# FI-FINAL: FRAME_STORE32 4, $r4
# FI-FINAL-NEXT: CALL_I32
# FI-FINAL-NEXT: $r5 = FRAME_LOAD32 4
# FI-FINAL-NOT: %stack.
# FI-FINAL-LABEL: name:            brace_system_call_leaf
# PIPELINE: Pass Arguments:
# PIPELINE-SAME: -stack-slot-coloring
# PIPELINE-SAME: -machineverifier -brace-finalize-byte-frame -machineverifier -brace-verify-post-byte-frame
# PIPELINE-SAME: -stack-frame-layout -machineverifier -brace-finalize-branches -machineverifier -brace-verify-final-byte-frame-publication
# BOOKKEEPING-MULTIPLE: LLVM ERROR: brace64 S3b.7c byte-frame finalizer: multiple live spill objects have no canonical transfer pseudo
# BOOKKEEPING-SHAPE: LLVM ERROR: brace64 S3b.7c byte-frame finalizer: restart bookkeeping is not one exact leading inert i32 spill record
# NO-SPILL: LLVM ERROR: brace64 S3b.7c byte-frame finalizer: BF1 retained IR requires exactly one i32 call-live spill
# NO-FRAME: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: BF1 retained IR requires one semantic frame
# NO-FRAME-MMO-FIRST: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: fixed-stack MMO survived finalization
# FINAL-NO-FRAME: LLVM ERROR: brace64 S3b.7c final-publication verifier: BF1 retained IR requires one semantic frame
# UNREGISTERED-RESTART: LLVM ERROR: brace64 S3b.7c byte-frame selector: -start-after=brace-verify-final-byte-frame-publication is not one of the five registered restart seams
# START-BEFORE: LLVM ERROR: brace64 S3b.7c byte-frame selector: -start-before=machine-opt-remark-emitter,2 is not an admitted restart boundary
# MODULE-ASM: LLVM ERROR: brace64 S3b.5 direct-call ABI: globals, aliases, ifuncs, and module asm are not admitted
# POST-FI: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: FrameIndex survived finalization
# POST-MMO: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: fixed-stack MMO survived finalization
# LEAF-FRAME: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: helper must have frame_size=0 and exactly one valued Return
# CROSS-BLOCK: LLVM ERROR: brace64 S3b.7c post-byte-frame verifier: BF1 Store32(4)/Call/Load32(4) order is not exact

#--- renumber.py
from pathlib import Path
import sys

assert len(sys.argv) == 4
dead_count = int(sys.argv[1])
assert dead_count in (1, 2)
source = Path(sys.argv[2]).read_text()
root_marker = "name:            brace_system_entry\n"
leaf_marker = "name:            brace_system_call_leaf\n"
assert source.count(root_marker) == 1
assert source.count(leaf_marker) == 1
root_start = source.index(root_marker)
root_end = source.index(leaf_marker, root_start)
root = source[root_start:root_end]
stack_start = root.index("stack:\n")
stack_end = root.index("entry_values:", stack_start)
stack = root[stack_start:stack_end]
lines = stack.splitlines(keepends=True)
anchors = [i for i, line in enumerate(lines)
           if line.startswith("  - { id: 0, name: '', type: spill-slot,")]
assert anchors == [1]
assert sum(line.startswith("  - { id:") for line in lines) == 1
live = lines[1].replace("id: 0", f"id: {dead_count}", 1)
bookkeeping = [
    f"  - {{ id: {i}, type: spill-slot, offset: 0, size: 4, alignment: 4 }}\n"
    for i in range(dead_count)
]
lines[1:2] = bookkeeping + [live]
root = root[:stack_start] + "".join(lines) + root[stack_end:]
body_start = root.index("body:")
assert root[:body_start].count("%stack.0") == 0
assert root[body_start:].count("%stack.0") == 4
root = root[:body_start] + root[body_start:].replace(
    "%stack.0", f"%stack.{dead_count}")
assert root[body_start:].count(f"%stack.{dead_count}") == 4
result = source[:root_start] + root + source[root_end:]
Path(sys.argv[3]).write_text(result)

#--- remove-frame.py
from pathlib import Path
import sys

assert len(sys.argv) == 4
mode = sys.argv[1]
assert mode in ("pre", "post", "post-mmo")
source = Path(sys.argv[2]).read_text()
root_marker = "name:            brace_system_entry\n"
leaf_marker = "name:            brace_system_call_leaf\n"
assert source.count(root_marker) == 1
assert source.count(leaf_marker) == 1
root_start = source.index(root_marker)
root_end = source.index(leaf_marker, root_start)
root = source[root_start:root_end]

def remove_exact_line(text, line):
    exact = line + "\n"
    assert text.count(exact) == 1
    return text.replace(exact, "", 1)

if mode == "pre":
    stack_start = root.index("stack:\n")
    stack_end = root.index("entry_values:", stack_start)
    stack = root[stack_start:stack_end]
    assert stack.count("type: spill-slot") == 1
    root = root[:stack_start] + "stack:           []\n" + root[stack_end:]
    root = remove_exact_line(
        root,
        "    SPILL_STORE32 $r4, %stack.0 :: (store (s32) into %stack.0)")
    root = remove_exact_line(
        root,
        "    $r5 = SPILL_LOAD32 %stack.0 :: (load (s32) from %stack.0)")
else:
    assert root.count("stack:           []\n") == 1
    root = remove_exact_line(root, "    FRAME_ENTER 16")
    root = remove_exact_line(root, "    FRAME_STORE32 4, $r4")
    root = remove_exact_line(root, "    $r5 = FRAME_LOAD32 4")
    root = remove_exact_line(root, "    FRAME_LEAVE")

joint = "    $r4 = AND32 killed $r4, killed $r5\n"
assert root.count(joint) == 1
root = root.replace(joint, "    $r4 = MOV32 killed $r4\n", 1)
assert "FRAME_" not in root
if mode == "post-mmo":
    empty = "stack:           []\n"
    assert root.count(empty) == 1
    record = ("stack:\n"
              "  - { id: 0, type: spill-slot, offset: 0, size: 4, "
              "alignment: 4 }\n")
    root = root.replace(empty, record, 1)
    load = next(line for line in root.splitlines(keepends=True)
                if line.startswith("    $r4 = LOAD32 killed $r0 :: "))
    assert root.count(load) == 1
    root = root.replace(
        load, load.rstrip("\n") + ", (load (s32) from %stack.0)\n", 1)
    assert root.count("%stack.0") == 1
else:
    assert "%stack." not in root
Path(sys.argv[3]).write_text(source[:root_start] + root + source[root_end:])

#--- post-forge.py
from pathlib import Path
import sys

assert len(sys.argv) == 4
mode = sys.argv[1]
assert mode in ("fi", "mmo", "leaf", "split")
source = Path(sys.argv[2]).read_text()
root_marker = "name:            brace_system_entry\n"
leaf_marker = "name:            brace_system_call_leaf\n"
assert source.count(root_marker) == 1
assert source.count(leaf_marker) == 1
root_start = source.index(root_marker)
leaf_start = source.index(leaf_marker, root_start)
root = source[root_start:leaf_start]
leaf = source[leaf_start:]

def add_root_stack(text):
    empty = "stack:           []\n"
    assert text.count(empty) == 1
    record = ("stack:\n"
              "  - { id: 0, type: spill-slot, offset: 0, size: 4, "
              "alignment: 4 }\n")
    return text.replace(empty, record, 1)

if mode == "fi":
    root = add_root_stack(root)
    old = "    FRAME_STORE32 4, $r4\n"
    assert root.count(old) == 1
    root = root.replace(old, "    FRAME_STORE32 %stack.0, $r4\n", 1)
elif mode == "mmo":
    root = add_root_stack(root)
    old = "    FRAME_STORE32 4, $r4\n"
    new = ("    FRAME_STORE32 4, $r4 :: "
           "(store (s32) into %stack.0)\n")
    assert root.count(old) == 1
    root = root.replace(old, new, 1)
elif mode == "leaf":
    anchor = "    $r0 = PADDR_IMM 2147483656\n"
    assert leaf.count(anchor) == 1
    leaf = leaf.replace(anchor, "    FRAME_ENTER 16\n" + anchor, 1)
else:
    header = "  bb.0.entry:\n"
    call = "    CALL_I32 @brace_system_call_leaf, csr_noregs, implicit-def $r4, implicit $r4\n"
    assert root.count(header) == 1
    assert root.count(call) == 1
    root = root.replace(
        header,
        header + "    successors: %bb.1(0x80000000)\n\n",
        1)
    root = root.replace(
        call,
        "  bb.1:\n    liveins: $r4\n\n" + call,
        1)

Path(sys.argv[3]).write_text(source[:root_start] + root + leaf)
